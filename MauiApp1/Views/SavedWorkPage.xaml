<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.SavedWorkPage"
             xmlns:vm="clr-namespace:MauiApp1.ViewModel"
             x:DataType="vm:WorkPerUserVM"
             Title="SavedWorkPage">
    <VerticalStackLayout>
        <Label 
Text="LocationW"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry  Placeholder="Enter Location " />
        
        <Label 
        Text="Time"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry  Placeholder="Enter Time " />


        <Label 
Text="Money Per Hour"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry Keyboard= "Telephone" Placeholder="Enter Money Per Hour" />

        <Button Command="{Binding SaveWorkPerUserCommand}" Text="Save"/>



    </VerticalStackLayout>
</ContentPage>