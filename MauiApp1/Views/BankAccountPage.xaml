<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.BankAccountPage"
             Title="BankAccountPage">
    <VerticalStackLayout>
        <Label 
            Text="פרטי בנק"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label 
Text="Bank name"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Picker x:Name="myGender" Title="Select an option">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>מזרחי טפחות</x:String>
                    <x:String>בנק יהב</x:String>
                    <x:String>בנק לאומי</x:String>
                    <x:String>הבנק הבינלאומי</x:String>
                    <x:String>בנק הפועלים</x:String>
                    <x:String>בנק פאגי</x:String>
                    <x:String>יו בנק</x:String>
                    <x:String>בנק מסד</x:String>
                    <x:String>בנק אגוד</x:String>
                    <x:String>וואן זירו</x:String>
                    <x:String>הבנק הדיגיטלי</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <Label 
Text="Bank number"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry Keyboard= "Telephone" Placeholder="Enter Bank number" />

        <Label 
Text=" Bank account number"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry Keyboard= "Telephone" Placeholder="Enter Bank account number " />


        <Button Clicked="Button_Clicked" Text="Save"/>
    </VerticalStackLayout>
</ContentPage>