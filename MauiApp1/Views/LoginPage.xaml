<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm ="clr-namespace:MauiApp1.ViewModel"
             x:Class="MauiApp1.Views.LoginPage"
             Title="LoginPage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label 
Text="Email"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry Keyboard="Email" Text="{Binding Email}" Placeholder="Enter email address" />


        <Label 
Text="Password"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry IsPassword="True" Text="{Binding Password}" Placeholder="Enter password" />

        <Button Command="{Binding LoginCommand}" Text="Save"/>


    </VerticalStackLayout>
</ContentPage>