<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.RegisterPage"
             xmlns:vm="clr-namespace:MauiApp1.ViewModel"
             x:DataType="vm:RegisterPageVM"
             Title="RegisterPage">
    <VerticalStackLayout>
        <Label 
            Text="Register"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label 
     Text="Email"
     VerticalOptions="Center" 
     HorizontalOptions="Center" />
        <Entry Keyboard="Email" Placeholder="Enter email address" Text="{Binding Email}"  />
        
        <Label 
Text="Name"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry  Placeholder="Enter name "  Text="{Binding Name}" />

        <Label 
Text="Password"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry IsPassword="True" Placeholder="Enter password" Text="{Binding Password}" />

        <Label 
Text="BornYear"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry Keyboard="Numeric" Placeholder="Enter BornYear address"  Text="{Binding BornYear}" />

        <Label 
Text="Gender"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Picker x:Name="myGender" Title="Select an option"  >
            <Picker.ItemsSource> 
                <x:Array Type="{x:Type x:String}">
                    <x:String>female</x:String>
                    <x:String>male</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>
        <Button Command="{Binding SaveRegisterCommand}" Text="Save"/>
        

    </VerticalStackLayout>
</ContentPage>