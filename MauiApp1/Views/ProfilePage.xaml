<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.ProfilePage"
             Title="ProfilePage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label 
Text="Email"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry Keyboard="Email" Placeholder="Enter email address" />

        <Label 
Text="Password"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry IsPassword="True" Placeholder="Change password" />

        <Label 
Text="Name"
VerticalOptions="Center" 
HorizontalOptions="Center" />
        <Entry  Placeholder="Change Username " />

        <Button Clicked="Button_Clicked" Text="Save"/>

        <Button Clicked="Button_Clicked" Text="Delete User"/>



    </VerticalStackLayout>
</ContentPage>